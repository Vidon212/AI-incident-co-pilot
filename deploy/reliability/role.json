{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "Role",
  "metadata": {
    "name": "reliability-controller",
    "namespace": "production"
  },
  "rules": [
    {
      "apiGroups": [
        "reliability.platform.io"
      ],
      "resources": [
        "investigations",
        "remediationproposals",
        "remediationpolicies"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "reliability.platform.io"
      ],
      "resources": [
        "investigations/status",
        "remediationproposals/status"
      ],
      "verbs": [
        "get",
        "update",
        "patch"
      ]
    }
  ]
}
