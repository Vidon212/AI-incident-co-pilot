{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemediationProposed",
  "description": "Wire shape only; runtime additionally checks identity, scope, size, and lifecycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "incident_id",
    "trace_id",
    "agent_version",
    "timestamp",
    "source",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "type": {
      "const": "remediation.proposed"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      }
    },
    "agent_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "investigator"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "resource",
        "intent_ref",
        "intent_sha256",
        "plan_ref",
        "plan_sha256",
        "verification_sha256",
        "evidence_ids"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "resource": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "intent_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "intent_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          }
        }
      }
    }
  }
}
