{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemediationVerified",
  "description": "Wire shape only; runtime additionally checks identity, scope, size, and lifecycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "incident_id",
    "trace_id",
    "agent_version",
    "timestamp",
    "source",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "type": {
      "const": "remediation.verified"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      }
    },
    "agent_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "verifier"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_event_id",
        "revision",
        "verification_sha256",
        "outcome",
        "report_ref",
        "report_sha256"
      ],
      "properties": {
        "proposal_event_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "verification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcome": {
          "enum": [
            "SUCCESS",
            "FAILED",
            "INCONCLUSIVE"
          ]
        },
        "report_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
