{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidentCreated",
  "description": "Wire shape only; runtime additionally checks identity, scope, size, and lifecycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "incident_id",
    "trace_id",
    "agent_version",
    "timestamp",
    "source",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "type": {
      "const": "incident.created"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      }
    },
    "agent_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "monitoring"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "environment",
        "signal",
        "value",
        "threshold",
        "started_at"
      ],
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "signal": {
          "enum": [
            "http_5xx_rate",
            "p99_latency_ms"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "threshold": {
          "type": "number",
          "minimum": 0
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "signal": {
                "const": "http_5xx_rate"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 1
              },
              "threshold": {
                "maximum": 1
              }
            }
          }
        }
      ]
    }
  }
}
